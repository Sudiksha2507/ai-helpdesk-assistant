# Optional: for REAL LLM-generated answers instead of the offline fallback.
# Get a free key (no credit card needed) at https://aistudio.google.com/apikey
# Then set it before running the app:
#   Windows (cmd):        set GEMINI_API_KEY=your-key-here
#   Windows (PowerShell):  $env:GEMINI_API_KEY="your-key-here"
#   Mac/Linux:             export GEMINI_API_KEY=your-key-here
#
# If you don't set this, the app still works fully — it just returns the
# matched knowledge-base article directly instead of an LLM-written answer.
GEMINI_API_KEY=
